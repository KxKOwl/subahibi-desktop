{
  "name": "subahibi-desktop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "<<美好的每一天~不连续存在~>>主题桌面页",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "styles": "sass css/main.scss dist/main.css",
    "build": "npm run check && npm run styles && esbuild src/main.ts --format=esm --outfile=dist/main.js --target=es2020",
    "watch": "esbuild src/main.ts --format=esm --outfile=dist/main.js --target=es2020 --watch",
    "watch:styles": "sass --watch css/main.scss:dist/main.css",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "sass": "^1.103.1",
    "typescript": "^5.5.4"
  }
}
